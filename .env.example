# --- BACKEND CONFIGURATION ---
# Database Configuration (Neon for Production, Docker for Local)
# IMPORTANT: Use the exact variable names below as they are mapped in application.properties

# For Neon (Production), use the full URL with ?sslmode=require
DB_URL=jdbc:postgresql://<host>/<dbname>?sslmode=require
DB_USERNAME=your_username
DB_PASSWORD=your_password

# For Local Docker Dev (if you copy this to .env, uncomment these and set appropriately)
# DB_URL=jdbc:postgresql://db:5432/vouchervault
# DB_USERNAME=postgres
# DB_PASSWORD=password

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Security Configuration
JWT_SECRET=your_long_random_jwt_secret_at_least_32_chars
SERVER_MASTER_SECRET=your_32_char_master_encryption_secret

# CORS Configuration
# Set to your Vercel frontend URL in production
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- FRONTEND CONFIGURATION ---
# Backend API URL
VITE_API_URL=http://localhost:8080/api
